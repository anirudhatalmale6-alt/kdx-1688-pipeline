# Copy to /etc/kdx/kdx.env, fill in the real values, then:
#   chown root:kdx /etc/kdx/kdx.env && chmod 640 /etc/kdx/kdx.env
#
# Nothing in this file belongs in the repository. The token that was sent over
# chat should be rotated in the 1688 console before it is used here.

# --- 1688 ---------------------------------------------------------------
KDX_1688_APP_KEY=
KDX_1688_APP_SECRET=
KDX_1688_TOKEN=
KDX_1688_REFRESH_TOKEN=

# The second app, the one approved for the distribution (分销) package. Leave
# these empty and everything runs on the first app exactly as before; fill them
# in and the product detail, SKU, keyword-search and freight calls move over to
# it on their own.
#
# Both apps stay. The first one is the only one that holds
# com.alibaba.linkplus/alibaba.cross.similar.offer.search - the image search the
# price comparison is built on - and it is not in the second app's permission
# list. Deleting the first app would take the price comparison with it.
KDX_1688_B_APP_KEY=
KDX_1688_B_APP_SECRET=
KDX_1688_B_TOKEN=
KDX_1688_B_REFRESH_TOKEN=

# The one channel this appKey holds. alibaba.product.get is still
# gw.APIACLDecline; the day that changes, set this to aop and nothing else moves.
KDX_SOURCE=linkplus

# --- where the run keeps its state --------------------------------------
KDX_STATE_DIR=/opt/kdx

# The starting photographs. One image URL per line; must be reachable from
# China. Add to it whenever you want the catalogue steered somewhere new.
KDX_SEEDS=/opt/kdx/seeds.txt

# --- the client's rules -------------------------------------------------
KDX_DAILY_POINTS=300

# --- translation --------------------------------------------------------
# Without this the run still works, and every title is carried through in
# Chinese and marked untranslated rather than being guessed at.
OPENAI_API_KEY=

# --- price comparison ---------------------------------------------------
KDX_SERPAPI_KEY=
KDX_SEARCH_MONTHLY_CAP=30000

# --- publishing ---------------------------------------------------------
KDX_BASE_URL=https://kdx-sa.com
KDX_API_TOKEN=
