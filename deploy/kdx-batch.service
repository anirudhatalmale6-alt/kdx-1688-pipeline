[Unit]
Description=KDX: one small batch of 1688 products, priced and published
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kdx
WorkingDirectory=/opt/kdx/app
EnvironmentFile=/etc/kdx/kdx.env
# Small and often, which is what the client asked for on 2 September: "make it
# split into small batches", "keep it running all day without stopping". The
# day's total is still KDX_DAILY_POINTS in budget.py - this only changes how the
# day is spread, from one long run at midnight to a batch every twenty minutes.
#
# TEN, not forty. Measured on this machine: 53 seconds a product before the
# 3 September concurrency work, so ten is about eight minutes inside a twenty
# minute window and forty was thirty-five - longer than the window and longer
# than the timeout below, so every batch would have been killed part-published.
# The full working is in kdx-batch.timer.
# BOTH batches, from 3 September, late. It was fast-only for a few hours,
# because a free-shipping product is requires_shipping=no: we absorb a carriage
# he prices BY VOLUME, and no dimension arrives from 1688 - 4 of 288 assembled
# products state one anywhere in their data. He settled it himself rather than
# waiting for a rate table that cannot be applied:
#
#   "الان بما انك ما تقدر تسحب ابعاد المنتج لذا افعل مثل ما قلت لك ... نبدأ دفعة
#    جديدة الى الشحن السريع والشحن المجاني"
#
# The floor under a heavy product is therefore the comparison itself, which is
# the rule the engine already held: found on one of the five platforms and
# priced above our cost, or not published. Their price contains the freight;
# ours does not, which is why the margin fallback is refused for heavy goods.
# Measured the night this changed: 5 heavy products, 0 published.
# --shipping fast holds the heavy side again.
ExecStart=/usr/bin/python3 /opt/kdx/app/daily_run.py --channel selected --shipping any --quota 10

# A batch that meets its predecessor exits 2 and says so. That is the lock
# working, not a failure, and it must not be reported as one - otherwise every
# slow batch paints the timer red and a real failure stops standing out.
SuccessExitStatus=2
# Twenty minutes is the gap between batches; a batch that has not finished in
# seventeen has hit something slow, and the next one will start clean.
#
# It was fifteen, and fifteen was measured before his import started answering
# slowly. Over the night of 3-4 September the batches ran 8.4, 12.3, 9.1, 13.0,
# 12.1, 7.8, 13.6 and 13.5 minutes: the ceiling was inside the normal range, not
# above it, and at 01:21 a batch reached it and was killed. Seventeen sits above
# every one of those and still cannot meet the next batch three minutes later.
#
# The kill itself was survivable. What was not is that it left daily.lock behind
# and the twenty batches after it exited in one second - six hours of silence.
# That is fixed in daily_run.take_lock, which now asks whether the process that
# took the lock is still there rather than how old the file is.
TimeoutStartSec=17min
Nice=10

ProtectSystem=strict
ReadWritePaths=/opt/kdx
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
